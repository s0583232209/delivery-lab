                  "pm.test(\"every item is created\", () => list.forEach(d => pm.expect(d.status).to.eql(\"created\")));",
                  "pm.test(\"B is in, A is out\", () => { pm.expect(ids).to.include(Number(pm.collectionVariables.get(\"idB\"))); pm.expect(ids).to.not.include(Number(pm.collectionVariables.get(\"idA\"))); });"
