                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test(\"is an array\", () => pm.expect(list).to.be.an(\"array\"));",
                  "pm.test(\"contains A and B\", () => { const ids = list.map(d => d.id); pm.expect(ids).to.include(Number(pm.collectionVariables.get(\"idA\"))); pm.expect(ids).to.include(Number(pm.collectionVariables.get(\"idB\"))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter: delivered",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/deliveries?status=delivered",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "deliveries"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "delivered"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const list = pm.response.json(); const ids = list.map(d => d.id);",
                  "pm.test(\"every item is delivered\", () => list.forEach(d => pm.expect(d.status).to.eql(\"delivered\")));",
                  "pm.test(\"A is in, B is out\", () => { pm.expect(ids).to.include(Number(pm.collectionVariables.get(\"idA\"))); pm.expect(ids).to.not.include(Number(pm.collectionVariables.get(\"idB\"))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter: created",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
