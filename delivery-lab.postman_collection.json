{
  "info": {
    "_postman_id": "28526500-3eb3-4238-955c-555ee2e10a39",
    "name": "delivery-lab API",
    "description": "Run the whole collection with the Collection Runner (right-click, Run collection).\nThe order matters: later requests use ids saved by earlier ones.\nStart every run against a freshly started server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "pm.test(\"status is ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Create and read",
      "item": [
        {
          "name": "Create delivery A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/deliveries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "deliveries"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipient\": \"Dana Levi\",\n  \"address\": \"Herzl 10, Tel Aviv\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "const d = pm.response.json();",
                  "pm.test(\"id is a number\", () => pm.expect(d.id).to.be.a(\"number\"));",
                  "pm.test(\"recipient and address are echoed\", () => { pm.expect(d.recipient).to.eql(\"Dana Levi\"); pm.expect(d.address).to.eql(\"Herzl 10, Tel Aviv\"); });",
                  "pm.test(\"new delivery has status created\", () => pm.expect(d.status).to.eql(\"created\"));",
                  "pm.collectionVariables.set(\"idA\", d.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create delivery B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/deliveries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "deliveries"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipient\": \"Avi Cohen\",\n  \"address\": \"Allenby 5, Haifa\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"ids are unique\", () => pm.expect(pm.response.json().id).to.not.eql(Number(pm.collectionVariables.get(\"idA\"))));",
                  "pm.collectionVariables.set(\"idB\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get delivery A",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/deliveries/{{idA}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "deliveries",
                "{{idA}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"same delivery\", () => { const d = pm.response.json(); pm.expect(d.id).to.eql(Number(pm.collectionVariables.get(\"idA\"))); pm.expect(d.recipient).to.eql(\"Dana Levi\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get missing delivery",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/deliveries/999999",
              "host": [
                "{{baseUrl}}"
              ],
